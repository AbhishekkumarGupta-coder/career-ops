# ── Required ──────────────────────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# ── TinyFish (free — web fetch + search for agents) ──────
# Get free key at: https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=your_tinyfish_key_here

# ── ScrapeGraphAI (structured extraction) ────────────────
# Get key at: https://scrapegraphai.com/
SCRAPEGRAPH_API_KEY=your_scrapegraph_key_here

# ── Sarvam AI (Indian-language voice STT + TTS) ──────────
# Get free key at: https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_key_here

# ── Optional: Adzuna (free 250 req/day) ──────────────────
# Register at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# ── Optional: JSearch via RapidAPI (free tier) ───────────
# Register at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here
